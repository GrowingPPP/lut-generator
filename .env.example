# CHROMA 配置。复制为 .env 并填入真实值。
# 优先级:环境变量 > .env > OPENAI_API_KEY

CHROMA_LLM_MODEL=deepseek-flash
CHROMA_LLM_BASE_URL=https://api.deepseek.com
CHROMA_LLM_API_KEY=
# 单次最大 token。DeepSeek 的 thinking mode 默认开启,思考与输出共享这个预算,
# 给太小会返回空内容(reasoning_tokens 占满预算),表现为「按了确认却被反问一句」。
# 本项目抽取场景实测耗 130~420,默认 2000 余量充足。
CHROMA_LLM_MAX_TOKENS=2000

# JWT 签名密钥:至少 32 字符,必须换掉下面这行占位值(占位值会被后端拒绝启动)。
# 生成:python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CHROMA_JWT_SECRET=change-me-to-a-long-random-string

# 运行环境。设为 production 时强制要求显式配置 CHROMA_JWT_SECRET,
# 不允许用开发兜底密钥(兜底密钥写在 .jwt_secret,仅供本地开发)。
# CHROMA_ENV=production

# MySQL 连接
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=chroma

# 单次请求超时(秒)。openai SDK 默认是 600 秒,对界面里的请求太长,故显式收紧。
CHROMA_LLM_TIMEOUT=30
